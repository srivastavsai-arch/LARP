// LARP — Firestore security rules
// Mirror of the rules published in Firebase Console → Firestore Database → Rules.
// Ownership is enforced by Firebase Auth UID: a user can only touch
// the document in /members/{userId} where userId matches their auth UID.
// The uid, membership number, tier and member-since date are set at
// registration and can NEVER be modified by the client afterwards.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /members/{userId} {

      allow read: if request.auth != null
                    && request.auth.uid == userId;

      // The client may only ever write the fields set at registration
      // (app.js memberDocPayload). hasOnly() blocks arbitrary extra
      // fields such as isAdmin, role or license data.
      allow create: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.keys().hasOnly([
                      'uid', 'name', 'email', 'membershipNumber',
                      'membershipTier', 'status', 'memberSince',
                      'createdAt', 'updatedAt'
                    ]);

      allow update: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.data.uid == resource.data.uid
                    && request.resource.data.membershipNumber == resource.data.membershipNumber
                    && request.resource.data.membershipTier == resource.data.membershipTier
                    && request.resource.data.memberSince == resource.data.memberSince
                    && request.resource.data.keys().hasOnly([
                      'uid', 'name', 'email', 'membershipNumber',
                      'membershipTier', 'status', 'memberSince',
                      'createdAt', 'updatedAt'
                    ]);

      allow delete: if false;
    }

    // Guests mint a license WITHOUT an account. Identity is the
    // anonymous Firebase Auth UID (persists across refresh/reopen).
    // quota is the hard per-guest cap, enforced here server-side:
    // quotaUsed can only move upward and never past quota, and every
    // other field (uid, name, age, licenseNo, quota) is frozen.
    // The 13+ age rule is enforced HERE on the server, not just in
    // the frontend: a record below 13 can never be created.
    match /guests/{guestId} {

      allow read: if request.auth != null
                    && request.auth.uid == guestId;

      allow create: if request.auth != null
                    && request.auth.uid == guestId
                    && request.resource.data.uid == guestId
                    && request.resource.data.keys().hasOnly([
                      'uid', 'name', 'age', 'licenseNo', 'quota',
                      'quotaUsed', 'createdAt', 'updatedAt'
                    ])
                    && request.resource.data.quota == 1
                    && request.resource.data.quotaUsed == 1
                    && request.resource.data.age is int
                    && request.resource.data.age >= 13
                    && request.resource.data.licenseNo is string
                    && request.resource.data.name is string;

      allow update: if request.auth != null
                    && request.auth.uid == guestId
                    && request.resource.data.uid == resource.data.uid
                    && request.resource.data.name == resource.data.name
                    && request.resource.data.age == resource.data.age
                    && request.resource.data.licenseNo == resource.data.licenseNo
                    && request.resource.data.quota == resource.data.quota
                    && request.resource.data.quotaUsed >= resource.data.quotaUsed
                    && request.resource.data.quotaUsed <= resource.data.quota
                    && request.resource.data.keys().hasOnly([
                      'uid', 'name', 'age', 'licenseNo', 'quota',
                      'quotaUsed', 'createdAt', 'updatedAt'
                    ]);

      allow delete: if false;
    }

    // Global member counter (one entry per genuinely new member:
    // guest license or Google member). Writes are serialized by
    // client-side Firestore transactions, and the rules only allow
    // value to move up by exactly 1 per write — the count can never
    // be reset, inflated or desynced from the records.
    match /counters/{counterId} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.keys().hasOnly(['value'])
                    && request.resource.data.value == 1;
      allow update: if request.auth != null
                    && request.resource.data.keys().hasOnly(['value'])
                    && request.resource.data.value == resource.data.value + 1;
      allow delete: if false;
    }
  }
}