# LARP — Firebase configuration reference
# This static site (no build step) reads firebase-config.js directly.
# These values are PUBLIC web API keys by design (see firestore.rules).
# NEVER put Admin SDK / service-account credentials in any .env file.
#
# Copy to .env and fill ONLY if you add a build system that supports env vars.

VITE_FIREBASE_API_KEY=YOUR_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=YOUR_PROJECT.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
VITE_FIREBASE_STORAGE_BUCKET=YOUR_PROJECT.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=YOUR_SENDER_ID
VITE_FIREBASE_APP_ID=YOUR_APP_ID
